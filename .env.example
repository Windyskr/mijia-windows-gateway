# 复制为 .env 后填写。.env 已在 .gitignore 里，不会被提交。
# 每行 KEY=VALUE，# 开头是注释；不要在值的后面写注释。

# 设备：从 1 开始连续编号，可以配多台。MAC 和 bindkey 必填，名称可以省略。
# bindkey 是设备在米家 App 里绑定时生成的 32 位十六进制密钥，重新绑定后会改变。
DEVICE1_MAC=A4:C1:38:XX:XX:XX
DEVICE1_NAME=室内
DEVICE1_BINDKEY=00000000000000000000000000000000

#DEVICE2_MAC=A4:C1:38:XX:XX:XX
#DEVICE2_NAME=室外
#DEVICE2_BINDKEY=00000000000000000000000000000000

# 上传：每 60 秒把状态和新读数 POST 到这个地址，请求头带 Authorization: Bearer <UPLOAD_TOKEN>。
# 用 --listen 只看解密结果时可以不填。
UPLOAD_URL=https://example.com/api/ingest
UPLOAD_TOKEN=change-me

# 可选：每台设备最多每隔多少秒记一条读数（默认 300，最小 60）
#RECORD_INTERVAL=300
# 可选：设备多少秒没有新数据算离线（默认是 RECORD_INTERVAL 的 3 倍，至少 900）
#OFFLINE_AFTER=900
